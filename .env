# Database Configuration
# MySQL connection string for XAMPP
# Format: mysql://user:password@host:port/database
DATABASE_URL=mysql://root@localhost:3306/founderhq

# Server Configuration
# Port for the Express server (defaults to 5000 if not specified)
PORT=3000

# Node Environment
# Set to 'development' or 'production' for development and production builds
NODE_ENV=development

# Replit Specific Environment Variables (used in development/build process)
# These are automatically set by Replit and used for meta tag updates
# Internal app domain for Replit deployments
REPLIT_INTERNAL_APP_DOMAIN=

# Dev domain for Replit development environments
REPLIT_DEV_DOMAIN=

# Replit ID - used to detect if running in Replit environment
REPL_ID=
